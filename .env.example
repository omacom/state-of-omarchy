# Drizzle
# Replace with your DB credentials!
# DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend for emails.
# Leave empty in dev. Magic Link & OTP will be printed in your terminal.
# RESEND_API_KEY=""
RESEND_FROM="State of Omarchy <survey@omarchy.org>"

# Waitlist mode toggle — leave false/unset to show the email-only waitlist on "/".
# Set to "true" (and redeploy) when the survey itself opens.
SURVEY_LAUNCHED=false
