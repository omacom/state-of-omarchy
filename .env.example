# The Rails app does not load .env files itself. In development nothing is required:
# the survey is launched by default and sign-in emails are printed to the server log.
# For production these are set in config/deploy.yml (clear) and .kamal/secrets (secret).

# Public origin of the site, without scheme. Used for emailed links and social tags.
APP_HOST=localhost:3000

# Resend API key. Production delivers through Resend's SMTP relay (smtp.resend.com:465).
RESEND_API_KEY=

# Verified sender for real delivery.
MAILER_FROM="State of Omarchy <survey@omarchy.org>"

# Waitlist mode toggle — false/unset shows the email-only waitlist on "/" and blocks /survey.
# Development defaults to true; production defaults to false (set in config/deploy.yml).
# SURVEY_LAUNCHED=false

# Never set DATABASE_URL: Rails reads config/database.yml (SQLite files under storage/).

# Edition served at /survey (a directory under surveys/).
SURVEY_EDITION=2026
